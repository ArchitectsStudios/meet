# Copy to .env at the repo root. Both apps read it in development.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Long random string; signs session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=
# Shared secret between web and bot internal API. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=
MONGODB_URI=mongodb://localhost:27017/meet
# Public URL of the web app (used for OAuth redirect and links in DMs)
APP_URL=http://localhost:3000
# Where the web app reaches the bot's internal API
BOT_API_URL=http://localhost:3001
