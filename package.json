{
  "name": "meet",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter \"@meet/*\" --parallel run dev",
    "build": "pnpm --filter \"@meet/*\" run build",
