# Copy to deploy/k8s/secret.env (gitignored), fill in, then on the server:
#   kubectl -n meet create secret generic meet-secrets --from-env-file=deploy/k8s/secret.env
# To change a value later:
#   kubectl -n meet create secret generic meet-secrets --from-env-file=deploy/k8s/secret.env --dry-run=client -o yaml | kubectl apply -f -
#   kubectl -n meet rollout restart deploy/web deploy/bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# openssl rand -base64 32
AUTH_SECRET=
# openssl rand -hex 32
INTERNAL_API_SECRET=
MONGO_ROOT_USERNAME=meet
# openssl rand -hex 24  (hex keeps the URI below free of characters that need escaping)
MONGO_ROOT_PASSWORD=
MONGODB_URI=mongodb://meet:CHANGE_ME@mongo.meet.svc.cluster.local:27017/meet?authSource=admin
